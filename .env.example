# Uso local: copie este arquivo para .env.local e preencha (esse arquivo NÃO vai para o Git).
# Em produção: cadastre as mesmas variáveis na Vercel (Settings > Environment Variables)
# e faça um NOVO deploy (variáveis só valem para deploys feitos depois de cadastradas).
#
# Sem aspas e sem espaços.
GOOGLE_PLACES_API_KEY=
# Place ID começa com "ChIJ..." (não use o CID 0x..:0x.. nem a URL do Maps)
GOOGLE_PLACE_ID=
